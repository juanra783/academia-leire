:root{--bg1:#fff7df;--bg2:#e7f3ff;--card:#ffffff;--text:#263238;--muted:#64748b;--primary:#7c5cff;--primary2:#ff8fb3;--ok:#16a34a;--bad:#dc2626;--line:#e5e7eb;--shadow:0 18px 45px rgba(31,41,55,.12)}*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--text);background:linear-gradient(135deg,var(--bg1),var(--bg2));min-height:100vh}.wrap{width:min(1120px,92%);margin:auto}.topbar{padding:22px 0;display:flex;gap:16px;justify-content:space-between;align-items:center}.brand{font-weight:900;font-size:1.35rem}.nav{display:flex;gap:10px;flex-wrap:wrap}.nav a,.btn{border:0;border-radius:16px;padding:11px 16px;background:var(--primary);color:#fff;text-decoration:none;font-weight:800;cursor:pointer;display:inline-block}.nav a.secondary,.btn.secondary{background:#fff;color:var(--primary);border:1px solid #ded7ff}.hero{display:grid;grid-template-columns:1.2fr .8fr;gap:24px;align-items:stretch;padding:25px 0}.card{background:rgba(255,255,255,.9);border:1px solid rgba(255,255,255,.8);border-radius:28px;box-shadow:var(--shadow);padding:26px}.card h1{font-size:clamp(2rem,5vw,4rem);line-height:.95;margin:0 0 14px}.card h2{margin:0 0 14px}.muted{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin:18px 0}.subject{padding:22px;border-radius:24px;background:#fff;border:1px solid var(--line);text-decoration:none;color:var(--text);box-shadow:0 10px 25px rgba(0,0,0,.05)}.subject strong{font-size:1.2rem;display:block}.pill{display:inline-block;padding:6px 10px;border-radius:999px;background:#f1efff;color:var(--primary);font-weight:800;font-size:.85rem}.form{display:grid;gap:14px}.input,select,textarea{width:100%;border:1px solid var(--line);border-radius:16px;padding:12px 14px;font-size:1rem;background:#fff;color:var(--text)}textarea{min-height:110px;resize:vertical}.table{width:100%;border-collapse:collapse;background:#fff;border-radius:18px;overflow:hidden}.table th,.table td{padding:12px;border-bottom:1px solid var(--line);text-align:left}.table th{background:#f8fafc}.question{padding:18px;border:1px solid var(--line);border-radius:20px;background:#fff;margin:14px 0}.option{display:block;margin:8px 0;padding:12px;border:1px solid var(--line);border-radius:14px;background:#fafafa}.ok{color:var(--ok);font-weight:900}.bad{color:var(--bad);font-weight:900}.notice{padding:13px 16px;border-radius:16px;background:#ecfeff;border:1px solid #bae6fd;margin:12px 0}.score{font-size:3rem;font-weight:950;color:var(--primary);margin:0}.footer{padding:28px 0;color:var(--muted);font-size:.9rem}@media(max-width:760px){.hero{grid-template-columns:1fr}.topbar{align-items:flex-start;flex-direction:column}.card{padding:20px}.table{font-size:.9rem}}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin:18px 0}.mini{background:#fff;border:1px solid var(--line);border-radius:22px;padding:18px;box-shadow:0 10px 25px rgba(0,0,0,.05)}.mini b{display:block;font-size:1.7rem;color:var(--primary)}.mini span{color:var(--muted);font-size:.92rem}.grid.small{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}details{margin-top:14px;background:#f8fafc;border:1px solid var(--line);border-radius:18px;padding:14px}summary{cursor:pointer;font-weight:800;color:var(--primary)}
.bad.notice{background:#fef2f2;border-color:#fecaca}.ok.notice{background:#f0fdf4;border-color:#bbf7d0}.subject .btn{margin-top:8px}.print-page h1{font-size:2.4rem}.answer-line{border-bottom:1px solid #222;height:34px;margin-top:14px}

/* V3.1 Andalucía */
.soft{background:linear-gradient(135deg,#ffffff,#f7f2ff)}
.progress{position:relative;overflow:hidden}
.progress:after{content:"";position:absolute;left:0;right:0;bottom:0;height:7px;background:#e5e7eb}
.progress.ok:after{background:#16a34a}.progress.good:after{background:#65a30d}.progress.warn:after{background:#f59e0b}.progress.bad:after{background:#dc2626}.progress.neutral:after{background:#c4b5fd}
.teacher p{font-size:1.15rem;line-height:1.65}
.reading{font-size:1.18rem;line-height:1.85;background:#fff;border:1px solid var(--line);border-radius:20px;padding:20px}
.linkbtn{border:0;background:transparent;color:var(--primary);font-size:1.1rem;font-weight:900;cursor:pointer;padding:0;text-align:left}
.subject ul{margin:12px 0 0;padding-left:20px;color:var(--muted)}
@media print{.topbar,.nav,.btn,.footer{display:none}.wrap{width:100%}.card{box-shadow:none;border:0}.question{break-inside:avoid}}

/* V3.3 - diseño infantil, avatar y progreso */
.kid-hero{display:grid;grid-template-columns:320px 1fr;gap:24px;align-items:stretch;padding:20px 0 28px}.avatar-card{position:relative;background:linear-gradient(145deg,#fff,#f8f0ff);border:1px solid rgba(255,255,255,.9);border-radius:34px;box-shadow:var(--shadow);padding:22px;text-align:center;overflow:hidden}.avatar-card:before{content:"";position:absolute;inset:-80px;background:radial-gradient(circle at top left,rgba(124,92,255,.18),transparent 38%),radial-gradient(circle at bottom right,rgba(216,180,95,.22),transparent 35%);pointer-events:none}.avatar{position:relative;width:min(230px,90%);border-radius:32px;display:block;margin:0 auto 12px}.level-badge{position:relative;display:inline-block;background:linear-gradient(135deg,#7c5cff,#9d8cff);color:#fff;padding:9px 16px;border-radius:999px;font-weight:950;box-shadow:0 10px 20px rgba(124,92,255,.25)}.xpbar,.goal,.mini-bar{height:14px;background:#eee7ff;border-radius:999px;overflow:hidden;margin:12px 0}.xpbar span,.goal span,.mini-bar span{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,#7c5cff,#ff8fb3,#d8b45f);transition:width .5s ease}.mini-bar{height:9px}.hero-main h1{font-size:clamp(2.2rem,5vw,4.4rem)}.stats.compact{grid-template-columns:repeat(auto-fit,minmax(130px,1fr));margin:14px 0}.split{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:18px 0}.badge-card{background:linear-gradient(135deg,#fff,#fff8df)}.admin-hero{grid-template-columns:260px 1fr}.admin-hero .avatar{width:190px}.subject,.card,.mini{animation:popIn .35s ease both}@keyframes popIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}@media(max-width:840px){.kid-hero,.split,.admin-hero{grid-template-columns:1fr}.avatar{width:190px}}

/* V4.0 Aventura + Luna IA */
.adventure-map{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;margin:20px 0}.world-card{display:block;text-decoration:none;color:inherit;background:linear-gradient(145deg,#fff,#f5f0ff);border:1px solid rgba(124,92,255,.18);border-radius:28px;padding:22px;box-shadow:0 18px 45px rgba(75,60,130,.12);transition:transform .18s ease,box-shadow .18s ease}.world-card:hover{transform:translateY(-5px);box-shadow:0 22px 55px rgba(75,60,130,.18)}.world-icon{font-size:48px;display:block;margin-bottom:8px}.world-card h2{margin:6px 0 8px}.world-card p{color:#675b7a}.dragon{background:linear-gradient(145deg,#fff8dd,#fff)}.dragon-big{font-size:110px;filter:drop-shadow(0 16px 18px rgba(124,92,255,.25));animation:floaty 3s ease-in-out infinite}.reward{background:linear-gradient(90deg,#fff3c4,#f3edff);border-color:#f0d77a}.avatar-card .avatar{object-fit:cover}.teacher p{line-height:1.65}.btn[disabled]{opacity:.45;cursor:not-allowed}@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}

/* V4.1/V4.7 - Entrenador inteligente, tienda, retos y Emilia */
.shop-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:18px;margin:18px 0}.shop-item{position:relative;background:#fff;border:1px solid var(--line);border-radius:26px;padding:20px;box-shadow:0 14px 35px rgba(31,41,55,.08);overflow:hidden}.shop-item:before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,rgba(124,92,255,.08),rgba(255,143,179,.08));pointer-events:none}.shop-item>*{position:relative}.shop-icon{font-size:48px;line-height:1;margin-bottom:10px}.shop-item h3{margin:4px 0 8px}.rarity-raro{border-color:#c4b5fd}.rarity-epico{border-color:#f0c96a;box-shadow:0 16px 40px rgba(216,180,95,.18)}.locked{opacity:.72;filter:saturate(.75)}.equipped{background:#dcfce7;color:#15803d}.task-card.done{background:linear-gradient(135deg,#f0fdf4,#fff);border-color:#bbf7d0}.hearts{font-size:1.35rem;letter-spacing:2px;margin:10px 0}.hearts.big{font-size:2rem}.battle-card{background:linear-gradient(145deg,#fff,#fff7df)}.battle-intro{background:linear-gradient(135deg,#fff7df,#f4efff)}.sticker-equipped{position:absolute;right:18px;top:18px;font-size:42px;filter:drop-shadow(0 8px 10px rgba(0,0,0,.18))}.equipped-frame.marco_dorado{border:4px solid #d8b45f}.equipped-frame.marco_morado{border:4px solid #9d8cff}.equipped-frame.marco_arcoiris{border:4px solid transparent;background:linear-gradient(#fff,#fff) padding-box,linear-gradient(135deg,#ff8fb3,#7c5cff,#d8b45f) border-box}.equipped-frame.marco_galaxia{border:4px solid #1e1b4b;background:radial-gradient(circle at top,#312e81,#fff 45%)}.has-fondo .card,.has-fondo .subject,.has-fondo .mini{backdrop-filter:blur(6px)}.fondo-fondo_castillo{background-image:radial-gradient(circle at top left,rgba(216,180,95,.35),transparent 32%),linear-gradient(135deg,#fff7df,#e7f3ff)}.fondo-fondo_bosque{background-image:radial-gradient(circle at top left,rgba(34,197,94,.25),transparent 35%),linear-gradient(135deg,#f0fdf4,#e7f3ff)}.fondo-fondo_isla{background-image:radial-gradient(circle at top right,rgba(14,165,233,.25),transparent 35%),linear-gradient(135deg,#ecfeff,#fff7df)}.fondo-fondo_estrellas{background-image:radial-gradient(circle at 20% 20%,rgba(255,255,255,.6),transparent 4%),radial-gradient(circle at top right,rgba(124,92,255,.22),transparent 35%),linear-gradient(135deg,#eff6ff,#f5f3ff)}.fondo-fondo_arcoiris{background-image:linear-gradient(135deg,rgba(255,143,179,.25),rgba(124,92,255,.18),rgba(216,180,95,.25))}.shop-hero .avatar{box-shadow:0 18px 45px rgba(124,92,255,.15)}@media(max-width:760px){.shop-grid{grid-template-columns:1fr}.hearts.big{font-size:1.45rem}}

/* V4.2 - Escanear y practicar */
.scan-hero{display:grid;grid-template-columns:1.35fr .65fr;gap:22px;align-items:stretch;padding:18px 0 24px}.scan-phone{font-size:92px;text-align:center;filter:drop-shadow(0 16px 22px rgba(124,92,255,.22));animation:floaty 3s ease-in-out infinite}.scan-card{background:linear-gradient(135deg,#fff,#eef7ff)}.scan-preview{width:100%;max-height:520px;object-fit:contain;border-radius:22px;border:1px solid var(--line);background:#fff;margin-top:12px}.scan-mini{background:linear-gradient(135deg,#fff,#fff8df)}.result-card{background:linear-gradient(135deg,#fff,#f0fdf4)}.bad-soft{background:#fff7f7;border-color:#fecaca}.question h3{margin-top:0}.scan-meta{display:flex;gap:10px;flex-wrap:wrap;margin:10px 0}.scan-meta .pill{background:#eef2ff}.file-hint{font-size:.92rem;color:var(--muted);margin-top:6px}@media(max-width:840px){.scan-hero{grid-template-columns:1fr}.scan-phone{font-size:70px}}

/* V4.7 - Emilia, compañera personalizable */
.emilia-card{background:linear-gradient(145deg,#fff,#fff2fb)}
.emilia-preview{position:relative;width:min(280px,90%);margin:0 auto 12px;border-radius:32px;overflow:hidden;box-shadow:0 18px 45px rgba(124,92,255,.18);background:linear-gradient(135deg,#ffe0f1,#e9dcff,#d8f8ff)}
.emilia-preview img{display:block;width:100%;height:auto}
.emilia-layer{position:absolute;z-index:2;display:flex;align-items:center;justify-content:center;background:transparent!important;border:0!important;box-shadow:none!important;backdrop-filter:none!important;font-size:30px;line-height:1;text-shadow:0 3px 8px rgba(31,41,55,.22);pointer-events:none}
.emilia-layer.head{top:14px;left:50%;transform:translateX(-50%);width:58px;height:42px}
.emilia-layer.glasses{top:118px;left:50%;transform:translateX(-50%);width:78px;height:34px;font-size:24px}
.emilia-layer.extra{right:16px;top:214px;width:54px;height:54px}
.emilia-layer.outfit{left:16px;bottom:80px;width:58px;height:58px}
.emilia-status{font-size:.92rem;color:var(--muted);line-height:1.5}.emilia-shop-hero{display:grid;grid-template-columns:320px 1fr;gap:24px;align-items:stretch;padding:20px 0 28px}.emilia-bubble{background:linear-gradient(135deg,#fff2fb,#eef7ff);border:1px solid rgba(124,92,255,.16)}
.category-tabs{display:flex;flex-wrap:wrap;gap:10px;margin:12px 0 18px}.category-tabs a{display:inline-block;text-decoration:none;background:#fff;border:1px solid var(--line);color:var(--primary);border-radius:999px;padding:8px 12px;font-weight:800}.category-tabs a:hover{background:#f1efff}.owned-badge{position:absolute;right:14px;top:14px;background:#dcfce7;color:#15803d;border-radius:999px;padding:5px 9px;font-size:.82rem;font-weight:900}.emilia-note{background:linear-gradient(90deg,#fdf2ff,#ecfeff);border-color:#e9d5ff}.shop-item.emilia-focused{background:linear-gradient(145deg,#fff,#fff7fc)}
@media(max-width:840px){.emilia-shop-hero{grid-template-columns:1fr}.emilia-preview{width:min(240px,82%)}}

/* V4.7 - Sección de estudio */
.study-page .study-hero{background:linear-gradient(135deg,#fff,#f5efff)}.study-section{background:rgba(255,255,255,.94);border:1px solid var(--line);border-radius:26px;box-shadow:var(--shadow);padding:24px;margin:18px 0}.study-section h2{margin-top:0;color:var(--primary)}.study-section h3{margin-bottom:8px}.study-list{padding-left:22px}.study-list li{margin:8px 0}.study-section p{line-height:1.65}.study-section:nth-of-type(even){background:linear-gradient(135deg,#fff,#effcff)}


/* V5.3: asignaturas arriba e icono actualizado */
.subjects-top { margin-top: 16px; }
.subjects-top h2 { margin-bottom: 4px; }
.subjects-top .grid { margin-top: 14px; }
@media (max-width: 720px){
  .subjects-top { margin-top: 10px; }
  .subjects-top .grid { grid-template-columns: 1fr; }
}


/* V5.5 - perfil arriba, últimos temas y Luna siempre a mano */
.recent-topics{background:linear-gradient(135deg,#fff,#fff2fb)}
.recent-card{position:relative;overflow:hidden}
.recent-card:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at top right,rgba(255,79,179,.10),transparent 38%);pointer-events:none}
.recent-card>*{position:relative}
.quick-actions{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 0}
.quick-actions .btn{padding:9px 12px;font-size:.92rem}
.luna-float{position:fixed;right:18px;bottom:18px;z-index:9999;display:flex;align-items:center;gap:9px;text-decoration:none;color:#fff;background:linear-gradient(135deg,#7c5cff,#ff4fb3);border-radius:999px;padding:12px 16px;box-shadow:0 18px 40px rgba(124,92,255,.35);font-weight:950;border:2px solid rgba(255,255,255,.85)}
.luna-float span{font-size:1.35rem;line-height:1}.luna-float:hover{transform:translateY(-2px);box-shadow:0 22px 50px rgba(124,92,255,.45)}
@media(max-width:720px){.luna-float{right:12px;bottom:12px;padding:11px 13px}.luna-float b{font-size:.92rem}.quick-actions .btn{flex:1 1 auto;text-align:center}}
@media print{.luna-float{display:none}}


/* V5.8 Emilia visual mejorada */
.emilia-preview{background:linear-gradient(180deg,#dff4ff,#f8f0ff);}
.emilia-preview img{display:block;width:100%;height:auto;object-fit:contain}
.emilia-result-grid{display:grid;grid-template-columns:280px 1fr;gap:22px;align-items:center}
.emilia-result-preview{max-width:260px;margin:0 auto;border-radius:28px}
.emilia-result-copy h2{margin:6px 0 10px}
.emilia-result.excelente{background:linear-gradient(145deg,#fff6d7,#fff)}
.emilia-result.muybien{background:linear-gradient(145deg,#eaf9ff,#fff)}
.emilia-result.regular{background:linear-gradient(145deg,#fff3e7,#fff)}
.emilia-result.apoyo{background:linear-gradient(145deg,#f7ecff,#fff)}
@media(max-width:840px){.emilia-result-grid{grid-template-columns:1fr}.emilia-result-preview{max-width:220px}}


/* V5.8 equipamiento transparente y botones de quitar */
.emilia-layer{background:transparent!important;border:0!important;box-shadow:none!important;backdrop-filter:none!important;text-shadow:0 3px 8px rgba(31,41,55,.22);pointer-events:none}
.inline-form{display:inline-block;margin-top:8px;margin-right:8px}
.btn.small, button.small{padding:7px 10px;font-size:.82rem;border-radius:12px}
.emilia-unequip-category{margin:4px 0 14px}
.table .btn.small{white-space:nowrap}
@media(max-width:720px){.table{font-size:.85rem}.table .btn.small{padding:6px 8px;font-size:.78rem}}

/* V5.9 temas en foco y archivado suave */
.active-topic{border-color:#ded7ff;background:linear-gradient(145deg,#fff,#fbf9ff)}
.archived-topic{opacity:.78;background:linear-gradient(145deg,#fcfcfc,#f7f7fb);border-style:dashed}
.archived-block{background:linear-gradient(145deg,#fff,#fafafa)}
.topic-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.topic-actions .btn{margin-top:0}

/* V5.12 · estudio visual para todos los temas */
.topic-hero,.visual-study-hero{background:linear-gradient(135deg,#fff,#fff4fb 50%,#eef7ff);position:relative;overflow:hidden}
.topic-hero:after,.visual-study-hero:after{content:"";position:absolute;right:-50px;top:-50px;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,rgba(255,79,179,.18),transparent 70%)}
.topic-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin-top:18px}
.topic-stats div{background:#fff;border:1px solid var(--line);border-radius:20px;padding:14px;text-align:center;box-shadow:0 8px 22px rgba(31,41,55,.06)}
.topic-stats b{display:block;font-size:1.8rem;color:var(--primary)}
.topic-stats span{font-size:.9rem;color:var(--muted);font-weight:800}
.topic-action-grid .visual-action{min-height:150px;display:flex;flex-direction:column;justify-content:space-between;background:linear-gradient(145deg,#fff,#f9f6ff)}
.preview-card details{background:#fff;border:1px solid var(--line);border-radius:18px;padding:14px}
.study-route{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:18px 0}
.study-route div{background:#fff;border:1px solid #eadcff;border-radius:18px;padding:12px;text-align:center;box-shadow:0 8px 18px rgba(124,92,255,.08)}
.study-route b{display:inline-grid;place-items:center;width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#7c5cff,#ff4fb3);color:#fff;margin-bottom:6px}
.study-route span{display:block;color:var(--muted);font-weight:900;font-size:.9rem}
.study-section{background:rgba(255,255,255,.94);border:1px solid rgba(255,255,255,.9);border-radius:28px;box-shadow:var(--shadow);padding:24px;margin:18px 0}
.visual-section{border-left:8px solid rgba(124,92,255,.55)}
.study-section-head{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.study-section-head h2{margin:0;font-size:1.55rem}
.study-icon{display:grid;place-items:center;min-width:46px;height:46px;border-radius:16px;background:linear-gradient(135deg,#f1efff,#fff1f7);font-size:1.55rem;box-shadow:0 10px 20px rgba(124,92,255,.10)}
.study-subbox{background:linear-gradient(135deg,#fbfdff,#fff);border:1px solid #edf0f6;border-radius:20px;padding:16px;margin:14px 0}
.study-subbox h3{margin-top:0;color:var(--primary)}
.study-list{display:grid;gap:8px;margin:12px 0 0;padding:0;list-style:none}
.study-list li{background:#fff;border:1px solid #edf0f6;border-radius:15px;padding:11px 13px;position:relative;padding-left:38px}
.study-list li:before{content:"✓";position:absolute;left:13px;top:10px;color:#16a34a;font-weight:950}
.exam-tips{background:linear-gradient(135deg,#f4efff,#fff)}
@media(max-width:720px){.study-route{grid-template-columns:repeat(2,1fr)}.study-section{padding:18px}.study-section-head{align-items:flex-start}.topic-stats{grid-template-columns:repeat(2,1fr)}}

/* V5.14 dinero, perfil y exámenes oficiales */
.wallet-score{font-size:2.7rem;color:#15803d;margin:8px 0 0}
.compact-form{margin-top:16px;max-width:420px}
.request-list{display:grid;gap:12px}.request-card{padding:16px}.request-card.pending{border-color:#f0c96a;background:linear-gradient(145deg,#fff8df,#fff)}.request-card.paid{border-color:#bbf7d0;background:linear-gradient(145deg,#f0fdf4,#fff)}.request-card.rejected{border-color:#fecaca;background:linear-gradient(145deg,#fef2f2,#fff)}
.status-pending{background:#fff7df;color:#a16207}.status-paid{background:#dcfce7;color:#15803d}.status-rejected{background:#fee2e2;color:#b91c1c}
.done-row{opacity:.82;background:#f8fafc}.done-row td{color:#64748b}.active-topic{border-color:#ded7ff;background:linear-gradient(145deg,#fff,#fbf9ff)}.archived-topic{opacity:.82;background:linear-gradient(145deg,#fcfcfc,#f7f7fb);border-style:dashed}.archived-block{background:linear-gradient(145deg,#fff,#fafafa)}.topic-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}.topic-actions .btn{margin-top:0}.inline-form{display:inline-block;margin:.25rem .35rem .25rem 0}.btn.small,button.small{padding:7px 10px;font-size:.82rem;border-radius:12px}

/* =========================================================
   ACADEMIA LEIRE V6 · DISEÑO PROFESIONAL + FANTASÍA
   ========================================================= */
:root{--v6-ink:#17142d;--v6-violet:#7656ff;--v6-pink:#ff65b7;--v6-cyan:#58dff5;--v6-gold:#ffd36b;--v6-deep:#13092f}
.v6-page{background:radial-gradient(circle at 12% 5%,#e9f9ff 0,transparent 28%),radial-gradient(circle at 85% 12%,#f7eaff 0,transparent 28%),linear-gradient(145deg,#fff9ed,#eef7ff);position:relative;overflow-x:hidden}.v6-ambient{position:fixed;inset:0;pointer-events:none;overflow:hidden}.v6-ambient i{position:absolute;border-radius:50%;filter:blur(70px);opacity:.22;animation:v6float 12s ease-in-out infinite alternate}.v6-ambient i:nth-child(1){width:320px;height:320px;background:#7b5cff;left:-90px;top:15%}.v6-ambient i:nth-child(2){width:280px;height:280px;background:#ff70bd;right:-80px;top:35%;animation-delay:-4s}.v6-ambient i:nth-child(3){width:220px;height:220px;background:#55dcf1;left:38%;bottom:-90px;animation-delay:-7s}.v6-topbar{position:relative;z-index:2}.v6-pill{background:linear-gradient(135deg,#7656ff,#ff65b7);color:#fff}.v6-glass{position:relative;z-index:1;background:linear-gradient(145deg,rgba(255,255,255,.88),rgba(255,255,255,.66));border:1px solid rgba(255,255,255,.92);backdrop-filter:blur(24px) saturate(145%);box-shadow:0 28px 80px rgba(53,43,92,.14)}.v6-repaso-hero{display:grid;grid-template-columns:1fr 230px;align-items:center;gap:20px;border-radius:38px;padding:42px;overflow:hidden}.v6-repaso-hero:after{content:"";position:absolute;width:340px;height:340px;border-radius:50%;right:-120px;top:-120px;background:radial-gradient(circle,rgba(121,88,255,.2),transparent 68%)}.v6-repaso-hero h1{font-size:clamp(2.4rem,6vw,4.8rem);line-height:.95;margin:8px 0 14px}.v6-repaso-hero p{font-size:1.08rem;line-height:1.65;color:#655f7b;max-width:700px}.v6-kicker{font-size:.72rem;letter-spacing:.22em;font-weight:950;color:#7a5dff}.v6-hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}.v6-main-btn{display:inline-block;text-decoration:none;color:#fff;background:linear-gradient(100deg,#5e54ff,#a650ff,#ff62b8);padding:14px 20px;border-radius:17px;font-weight:950;box-shadow:0 16px 35px rgba(126,77,255,.28);transition:.25s}.v6-main-btn:hover{transform:translateY(-3px);box-shadow:0 22px 44px rgba(126,77,255,.38)}.v6-orb{width:170px;height:170px;border-radius:50%;display:grid;place-items:center;margin:auto;position:relative;background:radial-gradient(circle at 35% 30%,#fff,#a2edff 18%,#785dff 54%,#251253 80%);box-shadow:0 0 45px rgba(98,211,255,.5),0 25px 55px rgba(52,31,112,.32);animation:v6orb 4s ease-in-out infinite}.v6-orb:before,.v6-orb:after{content:"";position:absolute;inset:-15px;border:1px solid rgba(121,92,255,.3);border-radius:50%;animation:v6spin 10s linear infinite}.v6-orb:after{inset:-30px;border-style:dashed;animation-direction:reverse}.v6-orb span{font-size:4rem;filter:drop-shadow(0 0 16px #fff)}.v6-mode-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:22px 0}.v6-mode-card{text-decoration:none;color:var(--v6-ink);background:#fff;border:1px solid rgba(255,255,255,.9);border-radius:28px;padding:24px;box-shadow:0 18px 50px rgba(45,37,77,.1);transition:.28s;position:relative;overflow:hidden}.v6-mode-card:after{content:"";position:absolute;inset:auto -45px -65px auto;width:140px;height:140px;border-radius:50%;background:var(--glow);opacity:.18}.v6-mode-card:hover{transform:translateY(-7px) scale(1.01);box-shadow:0 26px 60px rgba(45,37,77,.18)}.v6-mode-icon{display:block;font-size:2.4rem;margin-bottom:14px}.v6-mode-card b{display:block;font-size:1.18rem}.v6-mode-card small{display:block;color:#6b6680;line-height:1.5;margin-top:7px}.v6-card-cyan{--glow:#4de7ff}.v6-card-pink{--glow:#ff5db5}.v6-card-gold{--glow:#ffc947}.v6-card-violet{--glow:#7858ff}.v6-section{border-radius:30px;padding:28px;margin:20px 0}.v6-section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.v6-section h2{font-size:1.7rem;margin:4px 0}.v6-topic-card{display:grid;grid-template-columns:48px 1fr auto;gap:12px;align-items:center;background:rgba(255,255,255,.84);border:1px solid #ece9f7;border-radius:20px;padding:15px}.v6-topic-card>span{display:grid;place-items:center;width:48px;height:48px;border-radius:16px;background:linear-gradient(135deg,#f1edff,#e8fbff);font-size:1.5rem}.v6-topic-card b,.v6-topic-card small{display:block}.v6-topic-card small{color:#777188;margin-top:3px}.v6-topic-card a{text-decoration:none;color:#7455ff;font-weight:900}.v6-topic-card.warning>span{background:linear-gradient(135deg,#fff1dd,#fff8ec)}
@keyframes v6float{to{transform:translate(45px,35px) scale(1.12)}}@keyframes v6orb{50%{transform:translateY(-10px) rotate(2deg)}}@keyframes v6spin{to{transform:rotate(360deg)}}

/* Examen Loco V6 */
.crazy-body{margin:0;min-height:100vh;background:radial-gradient(circle at 15% 10%,rgba(95,73,255,.24),transparent 30%),radial-gradient(circle at 85% 20%,rgba(255,84,183,.18),transparent 30%),linear-gradient(155deg,#08051b,#170b38 50%,#07182b);color:#fff;overflow-x:hidden}.crazy-sky{position:fixed;inset:0;pointer-events:none;overflow:hidden}.crazy-sky:before{content:"";position:absolute;inset:0;background-image:radial-gradient(circle,#fff 0 1px,transparent 1.7px);background-size:150px 150px;opacity:.2;animation:crazyStars 45s linear infinite}.crazy-sky i{position:absolute;border-radius:50%;filter:blur(70px);opacity:.25;animation:v6float 13s ease-in-out infinite alternate}.crazy-sky i:nth-child(1){width:430px;height:240px;background:#5b50ff;left:-130px;top:15%}.crazy-sky i:nth-child(2){width:420px;height:250px;background:#ff4fb5;right:-160px;top:38%;animation-delay:-4s}.crazy-sky i:nth-child(3){width:280px;height:240px;background:#48dfff;left:35%;bottom:-130px;animation-delay:-7s}.crazy-shell{position:relative;z-index:2;width:min(790px,calc(100% - 28px));margin:auto;padding:15px 0 50px}.crazy-top{display:grid;grid-template-columns:52px 1fr 52px;align-items:center;text-align:center;gap:10px;margin-bottom:17px}.crazy-top small{display:block;color:#b7acd9;font-size:.63rem;letter-spacing:.2em;font-weight:900}.crazy-top b{font-size:1.55rem}.crazy-icon-btn{display:grid;place-items:center;width:52px;height:52px;border-radius:18px;color:#fff;text-decoration:none;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(18px);font-size:1.1rem;cursor:pointer}.crazy-screen{display:none;animation:crazyIn .5s cubic-bezier(.2,.8,.2,1)}.crazy-screen.active{display:block}.crazy-glass{background:linear-gradient(145deg,rgba(255,255,255,.105),rgba(255,255,255,.045));border:1px solid rgba(255,255,255,.15);box-shadow:0 25px 80px rgba(0,0,0,.37);backdrop-filter:blur(24px) saturate(145%)}.crazy-hero{display:grid;grid-template-columns:125px 1fr;align-items:center;gap:22px;border-radius:32px;padding:26px;overflow:hidden}.crazy-emblem{width:108px;height:108px;position:relative;display:grid;place-items:center}.crazy-emblem span{font-size:3.5rem;filter:drop-shadow(0 0 20px rgba(255,105,213,.7));animation:crazyPulse 2.5s ease-in-out infinite}.crazy-emblem i{position:absolute;inset:2px;border-radius:50%;border:2px solid rgba(97,231,255,.65);box-shadow:0 0 30px rgba(81,224,255,.45),inset 0 0 24px rgba(151,91,255,.35);animation:v6spin 11s linear infinite}.crazy-emblem i:after{content:"";position:absolute;inset:10px;border:1px dashed rgba(255,218,105,.55);border-radius:50%}.crazy-kicker{font-size:.69rem;letter-spacing:.22em;color:#66e7ff;font-weight:950}.crazy-hero h1,.crazy-result h1{font-size:clamp(2rem,6vw,3rem);line-height:1.02;margin:7px 0}.crazy-hero p,.crazy-result>p{color:#c7bfdf;line-height:1.55;margin:8px 0 0}.crazy-panel{border-radius:27px;padding:22px;margin-top:16px}.crazy-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}.crazy-heading h2{font-size:1.35rem;margin:0}.crazy-heading h2 span{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:12px;background:linear-gradient(145deg,#7358ff,#ae5bff);font-size:.7rem;margin-right:8px}.crazy-heading>b{font-size:.69rem;color:#ffb0c4;background:rgba(255,80,119,.1);border:1px solid rgba(255,97,136,.25);padding:7px 11px;border-radius:99px}.crazy-counts{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.crazy-count{min-height:145px;color:#fff;border:1px solid rgba(255,255,255,.11);border-radius:22px;background:linear-gradient(160deg,rgba(255,255,255,.08),rgba(255,255,255,.02));display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;transition:.27s}.crazy-count:hover,.crazy-count.selected{transform:translateY(-5px);border-color:#79eaff;box-shadow:0 15px 35px rgba(61,217,255,.15),inset 0 0 20px rgba(85,224,255,.08)}.crazy-count strong{font-size:2.2rem;line-height:1}.crazy-count span{font-size:1.3rem}.crazy-count small{font-weight:850}.crazy-count em{font-style:normal;color:#9d94bd;font-size:.66rem;margin-top:8px}.crazy-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.crazy-form-grid label{font-size:.75rem;color:#bbb2d7;font-weight:850}.crazy-form-grid select{margin-top:7px;background:rgba(7,4,24,.52);color:#fff;border:1px solid rgba(255,255,255,.14)}.crazy-difficulty{display:flex;gap:9px;margin-top:15px}.crazy-difficulty button{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);color:#fff;padding:9px 15px;border-radius:99px;font-size:.76rem;font-weight:850}.crazy-difficulty button.selected{background:linear-gradient(90deg,rgba(110,83,255,.58),rgba(184,79,255,.46));border-color:#b59cff}.crazy-record{display:grid;grid-template-columns:1fr 1px 1fr auto;align-items:center;gap:17px;border-radius:22px;padding:16px 20px;margin-top:16px}.crazy-record div{display:flex;flex-direction:column}.crazy-record small{font-size:.61rem;color:#9f96bd;letter-spacing:.13em;font-weight:900}.crazy-record strong{font-size:1.4rem}.crazy-record i{height:35px;background:rgba(255,255,255,.13)}.crazy-record>span{font-size:1.8rem;color:#ffd66e;filter:drop-shadow(0 0 13px #ffd76a)}.crazy-primary{position:relative;width:100%;border:0;color:#fff;border-radius:21px;padding:18px 22px;margin-top:18px;background:linear-gradient(100deg,#5a53ff,#a44cff,#ff5cba);font-weight:950;letter-spacing:.04em;box-shadow:0 18px 45px rgba(130,68,255,.4);display:flex;justify-content:center;gap:14px;cursor:pointer;overflow:hidden}.crazy-primary>i{position:absolute;width:40%;height:300%;left:-60%;top:-100%;transform:rotate(20deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.3),transparent);animation:crazyShine 4.5s infinite}.crazy-error{color:#ff9bb0;text-align:center;font-weight:800}.crazy-status{display:flex;justify-content:space-between;align-items:center;border-radius:22px;padding:15px 18px}.crazy-status>div{display:flex;gap:10px;align-items:center;font-size:2rem}.crazy-status span{display:flex;flex-direction:column}.crazy-status small{font-size:.62rem;letter-spacing:.12em;color:#bcb3d8}.crazy-status strong{font-size:1.5rem}.crazy-status time{background:rgba(8,5,25,.5);border:1px solid rgba(255,255,255,.1);padding:8px 12px;border-radius:13px;font-size:1.3rem;font-weight:900}.crazy-progress{height:10px;border-radius:99px;background:rgba(255,255,255,.08);margin:22px 4px 14px;overflow:hidden}.crazy-progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,#55dcff,#8f64ff,#ff67c8);box-shadow:0 0 16px #795dff;transition:.55s}.crazy-question{border-radius:30px;padding:25px;min-height:390px}.crazy-meta{display:flex;justify-content:space-between;gap:10px}.crazy-meta span{font-size:.67rem;padding:7px 10px;border-radius:99px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);color:#c9c1e5;font-weight:850}.crazy-question h2{font-size:clamp(1.35rem,4vw,1.85rem);line-height:1.32;margin:22px 0}.crazy-answers{display:grid;gap:11px}.crazy-answer{display:grid;grid-template-columns:38px 1fr;align-items:center;gap:12px;text-align:left;color:#fff;padding:15px 17px;border-radius:18px;border:1px solid rgba(255,255,255,.12);background:linear-gradient(135deg,rgba(255,255,255,.075),rgba(255,255,255,.025));cursor:pointer;transition:.22s}.crazy-answer:hover{transform:translateX(4px);border-color:rgba(111,228,255,.45)}.crazy-answer span{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:rgba(255,255,255,.08)}.crazy-answer.correct,.crazy-submit-answer.correct{border-color:#66efba;background:rgba(54,217,158,.13)}.crazy-answer.wrong,.crazy-submit-answer.wrong{border-color:#ff6684;background:rgba(255,72,111,.15);animation:crazyShake .38s}.crazy-text-answer{background:rgba(6,4,22,.48);border:1px solid rgba(255,255,255,.16);color:#fff}.crazy-submit-answer{border:0;border-radius:17px;padding:14px;background:linear-gradient(90deg,#6558ff,#b052ff);color:#fff;font-weight:900}.crazy-power{border-radius:20px;padding:15px 17px;margin-top:14px}.crazy-power>div{display:flex;justify-content:space-between;font-size:.67rem;letter-spacing:.1em;color:#c8c0df;font-weight:900;margin-bottom:8px}.crazy-power>span{display:block;height:7px;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.crazy-power i{display:block;width:0;height:100%;background:linear-gradient(90deg,#ffd25d,#ff74c7,#7559ff);box-shadow:0 0 15px #ff6ec5;transition:.55s}.crazy-quit,.crazy-home{display:block;margin:16px auto 0;border:0;background:transparent;color:#aaa1c9;text-decoration:none;font-weight:850;cursor:pointer}.crazy-result{text-align:center;border-radius:34px;padding:34px 26px}.crazy-portal{width:160px;height:160px;margin:0 auto 18px;display:grid;place-items:center;position:relative}.crazy-portal i{position:absolute;inset:0;border-radius:50%;border:2px solid rgba(101,229,255,.66);box-shadow:0 0 30px rgba(80,224,255,.42),inset 0 0 28px rgba(93,89,255,.35);animation:v6spin 8s linear infinite}.crazy-portal i:nth-child(2){inset:15px;border:1px dashed rgba(255,218,102,.72);animation-duration:13s;animation-direction:reverse}.crazy-portal span{font-size:4.8rem;filter:drop-shadow(0 0 22px rgba(255,209,92,.48));animation:v6orb 3s ease-in-out infinite}.crazy-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:20px 0}.crazy-stats div{padding:14px;border-radius:17px;background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.09)}.crazy-stats small{display:block;color:#a69dbc}.crazy-stats b{font-size:1.3rem}.crazy-explain{text-align:left;padding:16px;border-radius:17px;background:rgba(95,70,180,.13);border:1px solid rgba(180,151,255,.18)}.crazy-explain small{color:#71e7ff;font-weight:900;letter-spacing:.12em}.crazy-particles{position:fixed;inset:0;pointer-events:none;z-index:50;overflow:hidden}.crazy-particles i{position:absolute;left:50%;top:50%;width:8px;height:8px;border-radius:50%;background:var(--c);box-shadow:0 0 12px var(--c);animation:crazyBurst 1.1s forwards}.crazy-toast{position:fixed;z-index:60;left:50%;bottom:25px;transform:translate(-50%,20px);padding:12px 17px;border-radius:14px;background:rgba(15,8,39,.9);border:1px solid rgba(255,255,255,.14);opacity:0;transition:.3s}.crazy-toast.show{opacity:1;transform:translate(-50%,0)}.crazy-fail:after{content:"";position:fixed;inset:0;z-index:45;pointer-events:none;background:radial-gradient(circle,rgba(255,55,99,.08),rgba(101,0,25,.42));animation:crazyFail .6s forwards}
@keyframes crazyStars{to{background-position:600px 500px}}@keyframes crazyIn{from{opacity:0;transform:translateY(12px) scale(.99)}}@keyframes crazyPulse{50%{transform:scale(1.08)}}@keyframes crazyShine{0%,65%{left:-60%}85%,100%{left:120%}}@keyframes crazyShake{25%{transform:translateX(-7px)}50%{transform:translateX(6px)}75%{transform:translateX(-3px)}}@keyframes crazyBurst{to{transform:translate(var(--x),var(--y)) scale(.1) rotate(260deg);opacity:0}}@keyframes crazyFail{to{opacity:0}}
@media(max-width:820px){.v6-mode-grid{grid-template-columns:repeat(2,1fr)}.v6-repaso-hero{grid-template-columns:1fr;text-align:center}.v6-orb{width:140px;height:140px}.v6-hero-actions{justify-content:center}}
@media(max-width:620px){.v6-repaso-hero{padding:28px 20px}.v6-mode-grid{grid-template-columns:1fr 1fr;gap:10px}.v6-mode-card{padding:18px}.v6-topic-card{grid-template-columns:44px 1fr}.v6-topic-card a{grid-column:2}.crazy-hero{grid-template-columns:1fr;text-align:center}.crazy-emblem{margin:auto}.crazy-counts{grid-template-columns:repeat(2,1fr)}.crazy-form-grid{grid-template-columns:1fr}.crazy-question{padding:20px}.crazy-record{gap:10px;padding:15px}}
@media(prefers-reduced-motion:reduce){.v6-page *,.crazy-body *{animation-duration:.001ms!important;animation-iteration-count:1!important}}
.v6-dashboard-feature{display:grid;grid-template-columns:1fr 150px;align-items:center;gap:20px;border-radius:32px;padding:30px;margin:4px 0 20px;overflow:hidden}.v6-dashboard-feature h2{font-size:2rem;margin:5px 0}.v6-dashboard-feature p{color:#655f7b;line-height:1.55;max-width:720px}.v6-feature-emblem{width:120px;height:120px;margin:auto;border-radius:50%;display:grid;place-items:center;font-size:3.7rem;background:radial-gradient(circle at 35% 30%,#fff,#9deeff 18%,#7b5cff 55%,#281351 82%);box-shadow:0 0 35px rgba(91,213,255,.45),0 20px 42px rgba(65,40,130,.27);animation:v6orb 4s ease-in-out infinite}@media(max-width:620px){.v6-dashboard-feature{grid-template-columns:1fr;text-align:center;padding:24px 18px}.v6-dashboard-feature .v6-hero-actions{justify-content:center}.v6-feature-emblem{width:100px;height:100px;font-size:3rem}}

/* ACADEMIA STAR 6.1 — Examen Loco comparte el lenguaje visual del Nuevo Curso */
.crazy-body{background:linear-gradient(135deg,#f7f7fb 0%,#f1effb 52%,#eef4ff 100%)!important;color:#292640!important;overflow-x:hidden}.crazy-sky:before{background-image:radial-gradient(circle,#7658e8 0 1px,transparent 1.7px);opacity:.08}.crazy-sky i{filter:blur(80px);opacity:.18}.crazy-sky i:nth-child(1){background:#8b70ef}.crazy-sky i:nth-child(2){background:#f0a7ca}.crazy-sky i:nth-child(3){background:#8bdff1}.crazy-shell{width:min(980px,calc(100% - 28px));padding:18px 0 55px}.crazy-top{color:#292640}.crazy-top small{color:#8a849f}.crazy-top b{color:#292640}.crazy-icon-btn{color:#665d7b;background:rgba(255,255,255,.86);border:1px solid #e9e6f2;box-shadow:0 10px 25px rgba(54,42,108,.08)}.crazy-glass{background:rgba(255,255,255,.90);border:1px solid rgba(255,255,255,.96);box-shadow:0 18px 50px rgba(54,42,108,.10);backdrop-filter:blur(18px)}.crazy-hero{grid-template-columns:125px 1fr;border-radius:32px;padding:30px}.crazy-emblem{width:108px;height:108px}.crazy-emblem span{filter:drop-shadow(0 10px 16px rgba(118,88,232,.22))}.crazy-emblem i{border-color:rgba(118,88,232,.42);box-shadow:0 0 25px rgba(118,88,232,.18),inset 0 0 24px rgba(154,109,242,.14)}.crazy-emblem i:after{border-color:rgba(216,180,95,.55)}.crazy-kicker{color:#7658e8}.crazy-hero h1,.crazy-result h1{color:#292640}.crazy-hero p,.crazy-result>p{color:#716b82}.crazy-panel{border-radius:27px}.crazy-heading h2{color:#292640}.crazy-heading h2 span{background:linear-gradient(145deg,#7658e8,#a16ef1);color:#fff}.crazy-heading>b{color:#b35a72;background:#fff1f4;border-color:#f2d7df}.crazy-count{color:#3c3752;border-color:#e9e5f2;background:linear-gradient(160deg,#fff,#faf9fd);box-shadow:0 8px 25px rgba(54,42,108,.05)}.crazy-count:hover,.crazy-count.selected{border-color:#b9a7f7;box-shadow:0 15px 35px rgba(118,88,232,.13),inset 0 0 20px rgba(118,88,232,.05)}.crazy-count em{color:#8f899e}.crazy-form-grid label{color:#777086}.crazy-form-grid select{background:#fff;color:#38324c;border-color:#e7e3ef}.crazy-difficulty button{border-color:#e6e2ed;background:#faf9fc;color:#686179}.crazy-difficulty button.selected{background:#eee9ff;border-color:#cfc1ff;color:#7358db}.crazy-record{background:rgba(255,255,255,.9)}.crazy-record small{color:#918a9f}.crazy-record i{background:#e9e5ef}.crazy-record>span{color:#d39d24;filter:drop-shadow(0 0 9px rgba(211,157,36,.22))}.crazy-primary{background:linear-gradient(100deg,#7658e8,#9968ed,#b276f1);box-shadow:0 18px 45px rgba(118,88,232,.25)}.crazy-error{color:#c65b72}.crazy-status{color:#292640}.crazy-status small{color:#8a8498}.crazy-status time{background:#f7f5fb;border-color:#e8e4ef;color:#4a435c}.crazy-progress{background:#e7e3ef}.crazy-progress span{background:linear-gradient(90deg,#7658e8,#a16ef1,#c07bea);box-shadow:0 0 14px rgba(118,88,232,.28)}.crazy-question h2{color:#292640}.crazy-meta span{background:#f5f3f9;border-color:#e8e4ef;color:#716b80}.crazy-answer{color:#3c3752;border-color:#e7e3ef;background:linear-gradient(135deg,#fff,#faf9fd);box-shadow:0 8px 20px rgba(54,42,108,.04)}.crazy-answer:hover{border-color:#c5b5fa;background:#fcfbff}.crazy-answer span{background:#f0ecff;color:#7358dc}.crazy-answer.correct,.crazy-submit-answer.correct{border-color:#8edbb9;background:#effbf5}.crazy-answer.wrong,.crazy-submit-answer.wrong{border-color:#eea3b2;background:#fff1f3}.crazy-text-answer{background:#fff;border-color:#e6e1ed;color:#39334d}.crazy-submit-answer{background:linear-gradient(90deg,#7658e8,#9a69ef)}.crazy-power{background:#fbfaff}.crazy-power>div{color:#777087}.crazy-power>span{background:#e9e5ef}.crazy-power i{background:linear-gradient(90deg,#d9b35b,#a46deb,#7658e8);box-shadow:0 0 12px rgba(118,88,232,.2)}.crazy-quit,.crazy-home{color:#7c758c}.crazy-result{color:#292640}.crazy-portal i{border-color:rgba(118,88,232,.46);box-shadow:0 0 30px rgba(118,88,232,.16),inset 0 0 28px rgba(154,109,242,.12)}.crazy-portal i:nth-child(2){border-color:rgba(216,180,95,.65)}.crazy-stats div{background:#faf9fd;border-color:#e9e5ef}.crazy-stats small{color:#8e879d}.crazy-explain{background:#f3efff;border-color:#ded4ff}.crazy-explain small{color:#7658e8}.crazy-toast{background:rgba(255,255,255,.96);color:#40394f;border-color:#e5e1ed;box-shadow:0 12px 30px rgba(54,42,108,.12)}.crazy-fail:after{background:radial-gradient(circle,rgba(255,55,99,.03),rgba(232,108,131,.18))}
